# MODELO APENAS — configure localmente quando o aplicativo existir.
# Chave publicável do Supabase, jamais service_role/secret key no navegador.
VITE_SUPABASE_URL=https://PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=INSIRA_CHAVE_PUBLICA

# Credenciais administrativas devem ficar apenas em ambiente servidor
# e nunca num arquivo enviado ao GitHub.

# Opcional: domínio dos e-mails internos de login (padrão: entrenos.local)
# VITE_LOGIN_DOMAIN=entrenos.local

# Mostrar a demonstração com dados de exemplo mesmo com o banco ligado (só para prévias).
# VITE_DEMO=1
